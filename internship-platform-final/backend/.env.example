PORT=5000
FRONTEND_URL=http://localhost:5173
DB_USER=postgres
DB_HOST=localhost
DB_NAME=internship_platform
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_PORT=5432
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
PASSWORD_RESET_COOLDOWN_HOURS=24
POST_EDIT_DELETE_MINUTES=30
POST_RATE_WINDOW_SECONDS=60
POST_RATE_MAX=5

# Email (optional for local demo; without SMTP, OTPs are logged in backend console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Internship Platform <no-reply@example.com>

# Payments: use mock locally, or razorpay with Test Mode keys.
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional generic SMS webhook. It receives JSON: {to, message}
SMS_WEBHOOK_URL=
DEV_SHOW_OTP=true
